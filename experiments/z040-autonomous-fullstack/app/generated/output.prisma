model GearItem {
  id      String   @id @default(cuid())
  lockerId String?
  usageHours Int
  status  String  @default("stashed")
  locker   GearLocker? @relation(fields: [lockerId], references: [id], onDelete: SetNull)

  @@map("gear_items")
}

